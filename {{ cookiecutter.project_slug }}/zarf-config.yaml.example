# zarf-config.yaml

---
package:
  deploy:
    set:
      # Database container. 
      DATABASE_PGDATABASE: "{{ cookiecutter.project_slug }}"
      DATABASE_PGUSER: "postgres"
      DATABASE_PGPASSWORD: "postgres"

      # Backend container.
      BACKEND_SECRET_KEY: "squidfall"
      BACKEND_DEBUG: "True"
      BACKEND_DB_ENGINE: "postgres"
      BACKEND_PGHOST: "squidfall-database"
      BACKEND_PGDATABASE: "squidfall"
      BACKEND_PGPORT: "5432"
      BACKEND_PGSSLMODE: "disable"
      BACKEND_PGUSER: "postgres"
      BACKEND_PGPASSWORD: "postgres"

      # Frontend container.
      FRONTEND_PORT: "8080"
      FRONTEND_HOSTNAME: "0.0.0.0"
